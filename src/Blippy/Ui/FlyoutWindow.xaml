<Window x:Class="Blippy.Ui.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Blippy.Ui"
        Title="Blippy"
        Width="392"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="{StaticResource Rounded}"
        UseLayoutRounding="True">

    <!-- The margin leaves room for the shadow. -->
    <Grid Margin="16">
        <Border x:Name="Panel" CornerRadius="28" Background="{DynamicResource Background}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="10">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="30" ShadowDepth="6" Opacity="0.28" />
            </Border.Effect>
            <StackPanel>

                <!-- Hero header -->
                <Border x:Name="Hero" CornerRadius="22" Background="{DynamicResource Hero}" Padding="16,14" ClipToBounds="True">
                    <Grid>
                        <!-- A soft light that drifts around behind the header. -->
                        <Ellipse x:Name="DriftLight" Width="160" Height="160" HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,-70,-50,0" IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#55FFFFFF" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Logo" Width="44" Height="44" CornerRadius="22" Background="#33FFFFFF" VerticalAlignment="Center">
                                <ui:Icon Glyph="bluetooth" Stroke="White" Width="24" Height="24" StrokeWidth="2.2"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="blippy" Foreground="White" FontSize="24" FontWeight="Black" />
                                <TextBlock x:Name="Summary" Foreground="#E6FFFFFF" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Text="Looking for devices…" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="RefreshButton" Style="{StaticResource HeroIconButton}" ToolTip="Check now"
                                        Click="OnRefresh" Margin="0,0,6,0" AutomationProperties.Name="Check now">
                                    <ui:Icon x:Name="RefreshGlyph" Glyph="refresh" Stroke="White" Width="18" Height="18" />
                                </Button>
                                <Button x:Name="SettingsButton" Style="{StaticResource HeroIconButton}" ToolTip="Settings"
                                        Click="OnSettings" AutomationProperties.Name="Settings">
                                    <ui:Icon x:Name="SettingsGlyph" Glyph="settings" Stroke="White" Width="18" Height="18" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Margin="0,10,0,0">
                    <!-- Devices -->
                    <Grid x:Name="DevicesPage">
                        <ScrollViewer MaxHeight="430" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="DeviceList" Margin="0,0,0,-10" />
                        </ScrollViewer>

                        <StackPanel x:Name="EmptyState" Margin="12,18,12,14" Visibility="Collapsed">
                            <Border x:Name="EmptyArt" Width="76" Height="76" CornerRadius="38" Background="{DynamicResource PrimarySoft}">
                                <ui:Icon Glyph="device-gamepad-2" Stroke="{DynamicResource Primary}" Width="40" Height="40"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="EmptyTitle" Text="No batteries to show yet" Margin="0,14,0,4" HorizontalAlignment="Center"
                                       FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Text}" />
                            <TextBlock x:Name="EmptyBody" Style="{StaticResource Caption}" TextAlignment="Center" FontSize="13"
                                       Text="Turn on a controller or connect a Bluetooth device. It will pop up here on its own." />
                            <Button Style="{StaticResource PrimaryButton}" Content="Check now" Margin="0,14,0,0"
                                    HorizontalAlignment="Center" Click="OnRefresh" />
                        </StackPanel>
                    </Grid>

                    <!-- Settings -->
                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" MaxHeight="470"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="SettingsList">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <ui:Icon Glyph="playstation-triangle" Stroke="{DynamicResource Primary}" Width="18" Height="18" Margin="0,0,8,8" />
                                        <TextBlock Text="DualSense lightbar" Style="{StaticResource SectionTitle}" />
                                    </StackPanel>
                                    <CheckBox x:Name="LightbarToggle" Style="{StaticResource Toggle}" Content="Show battery on the lightbar"
                                              Checked="OnSettingToggled" Unchecked="OnSettingToggled" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,10"
                                               Text="A full controller glows in your color, then slides to red as it drains." />
                                    <WrapPanel x:Name="Swatches" />
                                    <Border x:Name="GradientPreview" Height="16" CornerRadius="8" Margin="0,6,0,4" />
                                    <Grid>
                                        <TextBlock Text="Empty" Style="{StaticResource Caption}" HorizontalAlignment="Left" />
                                        <TextBlock Text="Full" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Tray" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Show each device as" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                                    <WrapPanel>
                                        <RadioButton x:Name="StyleNumber" Style="{StaticResource Chip}" GroupName="TrayStyle" Content="Percentage" Checked="OnSettingToggled" />
                                        <RadioButton x:Name="StyleGlyph" Style="{StaticResource Chip}" GroupName="TrayStyle" Content="Device icon" Checked="OnSettingToggled" />
                                    </WrapPanel>
                                    <CheckBox x:Name="PerDeviceToggle" Style="{StaticResource Toggle}" Content="One tray icon per device"
                                              Checked="OnSettingToggled" Unchecked="OnSettingToggled" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                               Text="Windows tucks new icons under the ^ arrow. Drag them onto the taskbar to always see them." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Checking" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Check batteries every" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                                    <WrapPanel x:Name="RefreshChips" />
                                    <CheckBox x:Name="AlertsToggle" Style="{StaticResource Toggle}" Content="Nudge me at 20% and 10%"
                                              Checked="OnSettingToggled" Unchecked="OnSettingToggled" />
                                    <CheckBox x:Name="StartupToggle" Style="{StaticResource Toggle}" Content="Start with Windows"
                                              Checked="OnSettingToggled" Unchecked="OnSettingToggled" />
                                </StackPanel>
                            </Border>

                            <Grid Margin="4,0,4,6">
                                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}">
                                    Icons by Tabler Icons (MIT)
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource GhostButton}" Content="Open log" Click="OnOpenLog" />
                                    <Button Style="{StaticResource GhostButton}" Content="Quit Blippy" Click="OnQuit" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <TextBlock x:Name="Footer" Style="{StaticResource Caption}" Foreground="{DynamicResource TextMuted}"
                           Margin="6,4,6,2" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
